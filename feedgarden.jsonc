    {
      "id": "reddit",
      "name": "Reddit",
      "selection": {
        "method": "reddit-rss-percentile",
        "dailyLimit": 50,
        "updateDays": 7
      },
      "enabled": true,
      "timezone": "Asia/Shanghai",
      "intervalHours": 12,
      "streams": [
        {
          "id": "LocalLLaMA",
          "channels": [
            {
              "id": "rss",
              "kind": "feed",
              "enabled": true,
              "url": "https://www.reddit.com/r/LocalLLaMA/top.rss?t=week&limit=100",
              "transport": "curl",
