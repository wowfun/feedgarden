{
  "$schema": "./schemas/feedgarden.schema.json",
  "version": 2,
  "storage": {
    "database": ".local/feedgarden.sqlite",
    "directory": ".local"
  },
  "feed": {
    "directory": "content",
    "topics": "config/topics.json"
  },
  "collection": {
    "backfillDays": 7
  },
  "agent": {
    "command": "dsh",
    "model": "deepseek/deepseek-flash",
    "effort": "off",
    "version": "0.1.7-rc.2",
    "timeoutSeconds": 300,
    "maxBatchItems": 10,
    "maxInputChars": 24000,
    "maxItemChars": 4000,
    "maxDailyCalls": 80,
    "runtimeDirectory": ".local/dsh"
  },
  "publish": {
    "repository": "https://github.com/wowfun/feedgarden.git",
    "branch": "main",
    "auto": false
  },
  "sources": [
    {
      "id": "hackernews",
      "name": "Hacker News",
      "selection": {
        "method": "hn-engagement",
        "dailyLimit": 50,
        "updateDays": 7
      },
      "enabled": true,
      "timezone": "Asia/Shanghai",
      "intervalHours": 1,
      "streams": [
        {
          "id": "frontpage",
          "channels": [
            {
              "id": "firebase",
              "kind": "hn-api",
              "enabled": true,
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "rss",
              "kind": "feed",
              "enabled": true,
              "url": "https://news.ycombinator.com/rss",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        }
      ],
      "includeKeywords": []
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "enabled": true,
      "timezone": "Asia/Shanghai",
      "intervalHours": 6,
      "streams": [
        {
          "id": "news",
          "channels": [
            {
              "id": "list",
              "kind": "anthropic-html",
              "enabled": true,
              "url": "https://www.anthropic.com/news",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "sitemap",
              "kind": "sitemap",
              "enabled": true,
              "url": "https://www.anthropic.com/sitemap.xml",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        },
        {
          "id": "research",
          "channels": [
            {
              "id": "list",
              "kind": "anthropic-html",
              "enabled": true,
              "url": "https://www.anthropic.com/research",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "sitemap",
              "kind": "sitemap",
              "enabled": true,
              "url": "https://www.anthropic.com/sitemap.xml",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        },
        {
          "id": "engineering",
          "channels": [
            {
              "id": "list",
              "kind": "anthropic-html",
              "enabled": true,
              "url": "https://www.anthropic.com/engineering",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "sitemap",
              "kind": "sitemap",
              "enabled": true,
              "url": "https://www.anthropic.com/sitemap.xml",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        },
        {
          "id": "blog",
          "channels": [
            {
              "id": "list",
              "kind": "anthropic-html",
              "enabled": true,
              "url": "https://claude.com/blog",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "sitemap",
              "kind": "sitemap",
              "enabled": true,
              "url": "https://claude.com/sitemap.xml",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        }
      ],
      "includeKeywords": []
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "enabled": true,
      "timezone": "Asia/Shanghai",
      "intervalHours": 6,
      "streams": [
        {
          "id": "news",
          "channels": [
            {
              "id": "rss",
              "kind": "feed",
              "enabled": true,
              "url": "https://openai.com/news/rss.xml",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "sitemap",
              "kind": "sitemap",
              "enabled": true,
              "url": "https://openai.com/sitemap.xml",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        }
      ],
      "includeKeywords": []
    },
    {
      "id": "github",
      "name": "GitHub",
      "enabled": false,
      "timezone": "Asia/Shanghai",
      "intervalHours": 6,
      "streams": [
        {
          "id": "trending",
          "channels": [
            {
              "id": "trending",
              "kind": "github-trending",
              "enabled": true,
              "url": "https://github.com/trending?since=daily",
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            },
            {
              "id": "search",
              "kind": "github-search",
              "enabled": true,
              "transport": "fetch",
              "limit": 500,
              "authTokenEnv": "TWITTER_AUTH_TOKEN",
              "csrfTokenEnv": "TWITTER_CT0"
            }
          ]
        }
      ],
      "includeKeywords": []
    },
