{
  "name": "feedgarden",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25 || >=26 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "schema": "tsx scripts/schema.ts",
    "test:visual": "tsx scripts/visual-check.ts",
    "verify:agent": "tsx scripts/live-agent.ts",
    "verify:opencode": "tsx scripts/verify-opencode.ts",
    "verify:collect": "tsx scripts/live-collect.ts",
    "verify:scale": "tsx scripts/scale-check.ts",
    "verify:clippings": "tsx scripts/verify-clippings.ts",
    "verify:footer": "tsx scripts/verify-footer.ts",
    "verify:ui": "tsx scripts/ui-smoke.ts",
    "fdg": "tsx src/cli.ts",
    "dev:site:build": "tsx scripts/site-build.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "dev:site:serve": "tsx scripts/preview-site.ts",
    "check:architecture": "node scripts/architecture.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.5.9",
    "jsdom": "27.4.0",
    "jsonc-parser": "3.3.1",
    "luxon": "3.7.2",
    "micromark": "4.0.3",
    "micromark-util-decode-string": "2.0.1",
    "micromark-util-normalize-identifier": "2.0.1",
    "proper-lockfile": "4.1.2",
    "robots-parser": "3.0.1",
    "undici": "7.30.0",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/jsdom": "30.0.0",
    "@types/luxon": "3.7.1",
    "@types/node": "24.12.0",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "bin": {
    "fdg": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "resources"
  ]
}
