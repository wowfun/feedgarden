[
  {
    "id": "hackernews",
    "name": "Hacker News",
    "selection": {
      "method": "hn-engagement",
      "dailyLimit": 50,
      "updateDays": 7
    },
    "enabled": true,
    "timezone": "Asia/Shanghai",
    "intervalHours": 1,
    "streams": [
      {
        "id": "frontpage",
        "routes": [
          {
            "id": "firebase",
            "kind": "hn-api",
            "enabled": true,
            "transport": "fetch",
            "limit": 500,
            "authTokenEnv": "TWITTER_AUTH_TOKEN",
            "csrfTokenEnv": "TWITTER_CT0"
          },
          {
            "id": "rss",
            "kind": "feed",
            "enabled": true,
            "url": "https://news.ycombinator.com/rss",
            "transport": "fetch",
            "limit": 500,
            "authTokenEnv": "TWITTER_AUTH_TOKEN",
            "csrfTokenEnv": "TWITTER_CT0"
          }
        ]
      }
    ],
    "includeKeywords": [],
    "processAfter": "06:00"
  },
