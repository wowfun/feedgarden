{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 2
    },
    "storage": {
      "default": {
        "database": ".local/feedgarden.sqlite",
        "directory": ".local"
      },
      "type": "object",
      "properties": {
        "database": {
          "default": ".local/feedgarden.sqlite",
          "type": "string"
        },
        "directory": {
          "default": ".local",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "feed": {
      "default": {
        "directory": "content",
        "topics": "config/topics.json"
      },
      "type": "object",
      "properties": {
        "directory": {
          "default": "content",
          "type": "string"
        },
        "topics": {
          "default": "config/topics.json",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "default": {
        "backfillDays": 7,
        "enrichmentRefreshDays": 7
      },
      "type": "object",
      "properties": {
        "backfillDays": {
          "default": 7,
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "enrichmentRefreshDays": {
          "default": 7,
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "default": [
                "acp"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inheritEnvironment": {
              "default": [],
              "description": "Additional parent environment variable names explicitly passed to agent processes. Values stay outside configuration.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              }
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "timeoutSeconds": {
              "default": 300,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "maxBatchItems": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxInputChars": {
              "default": 24000,
              "type": "integer",
              "minimum": 4000,
              "maximum": 24000
            },
            "maxItemChars": {
              "default": 4000,
              "type": "integer",
              "minimum": 100,
              "maximum": 4000
            },
            "maxDailyCalls": {
              "default": 80,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 80
            },
            "runtimeDirectory": {
              "default": ".local/agents",
              "type": "string"
            },
            "workspaceRetentionDays": {
              "default": 7,
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            "maxTranscriptChunks": {
              "default": 64,
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "backend": {
              "default": "opencode",
              "type": "string",
              "const": "opencode"
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "default": [
                "acp"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inheritEnvironment": {
              "default": [],
              "description": "Additional parent environment variable names explicitly passed to agent processes. Values stay outside configuration.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              }
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "timeoutSeconds": {
              "default": 300,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "maxBatchItems": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxInputChars": {
              "default": 24000,
              "type": "integer",
              "minimum": 4000,
              "maximum": 24000
            },
            "maxItemChars": {
              "default": 4000,
              "type": "integer",
              "minimum": 100,
              "maximum": 4000
            },
            "maxDailyCalls": {
              "default": 80,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 80
            },
            "runtimeDirectory": {
              "default": ".local/agents",
              "type": "string"
            },
            "workspaceRetentionDays": {
              "default": 7,
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            "maxTranscriptChunks": {
              "default": 64,
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "backend": {
              "type": "string",
              "const": "dsh"
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "backend",
            "model"
          ],
          "additionalProperties": false
        }
      ]
    },
    "publish": {
      "default": {
        "repository": "https://github.com/wowfun/feedgarden.git",
        "branch": "main",
        "auto": false
      },
      "type": "object",
      "properties": {
        "repository": {
          "default": "https://github.com/wowfun/feedgarden.git",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "type": "string"
        },
        "auto": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "timezone": {
            "default": "Asia/Shanghai",
            "type": "string"
          },
          "intervalHours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "streams": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.-]+$"
                },
                "channels": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          },
                          "enabled": {
                            "default": true,
                            "type": "boolean"
                          },
                          "transport": {
                            "default": "fetch",
                            "type": "string",
                            "enum": [
                              "fetch",
                              "curl"
                            ]
                          },
                          "limit": {
                            "default": 500,
                            "description": "Maximum items for hn-api and arxiv-api. Other channel kinds use their feed window or adapter-specific bounds.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 2000
                          },
                          "authTokenEnv": {
                            "default": "TWITTER_AUTH_TOKEN",
                            "type": "string"
                          },
                          "csrfTokenEnv": {
                            "default": "TWITTER_CT0",
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "const": "podcast-rss"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "podcastName": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "url",
                          "podcastName"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          },
                          "enabled": {
                            "default": true,
                            "type": "boolean"
                          },
                          "transport": {
                            "default": "fetch",
                            "type": "string",
                            "enum": [
                              "fetch",
                              "curl"
                            ]
                          },
                          "limit": {
                            "default": 500,
                            "description": "Maximum items for hn-api and arxiv-api. Other channel kinds use their feed window or adapter-specific bounds.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 2000
                          },
                          "authTokenEnv": {
                            "default": "TWITTER_AUTH_TOKEN",
                            "type": "string"
                          },
                          "csrfTokenEnv": {
                            "default": "TWITTER_CT0",
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "hn-api",
                              "feed",
                              "sitemap",
                              "anthropic-html",
                              "github-trending",
                              "github-search",
                              "x-cli",
                              "follow-builders",
                              "arxiv-api",
                              "ph-html"
                            ]
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "id",
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "id",
                "channels"
              ],
              "additionalProperties": false
            }
          },
          "includeKeywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "selection": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "hn-engagement",
                  "reddit-rss-percentile"
                ]
              },
              "dailyLimit": {
                "default": 50,
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              },
              "updateDays": {
                "default": 7,
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            },
            "required": [
              "method"
            ],
            "additionalProperties": false
          },
          "agent": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "intervalHours",
          "streams"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "agent",
    "sources"
  ],
  "additionalProperties": false
}
