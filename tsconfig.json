{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": ".", "sourceMap": true, "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.mjs", "scripts/**/*.ts", "tests/**/*.ts"]
}
